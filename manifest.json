{
  "manifest_version": 3,
  "name": "Power Pilot",
  "description": "Inspect Dynamics 365 forms, collect option set values, and update field behavior.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/tool_icon.png",
    "32": "icons/tool_icon.png",
    "48": "icons/tool_icon.png",
    "128": "icons/tool_icon.png"
  },
  "action": {
    "default_title": "Power Pilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/tool_icon.png",
      "32": "icons/tool_icon.png",
      "48": "icons/tool_icon.png",
      "128": "icons/tool_icon.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.dynamics.com/*",
    "https://*.powerapps.com/*",
    "https://*.dynamics.microsoft.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.dynamics.com/*",
        "https://*.powerapps.com/*",
        "https://*.dynamics.microsoft.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
